{
  "name": "logship-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Command line tool that groups shipped log lines by service.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "logship": "bin/logship.js"
  },
  "scripts": {
    "build": "esbuild bin/logship.js --bundle --platform=node --format=cjs --packages=external --outfile=dist/logship.js",
    "test": "node --test \"test/*.test.js\"",
    "test:security": "node --test \"test/security/**/*.test.js\""
  },
  "dependencies": {
    "lodash": "4.17.10"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
